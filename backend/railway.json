{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "buildCommand": "mkdir -p dist && go build -o dist/server ./cmd/server && go build -o dist/migrate ./cmd/migrate",
        "watchPatterns": ["backend/**"]
    },
    "deploy": {
        "preDeployCommand": ["./dist/migrate up"],
        "startCommand": "./dist/server",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
