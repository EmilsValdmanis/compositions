BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/compositions?sslmode=disable
COOKIE_SECURE=false
# Enable only when every public request must pass through a trusted proxy.
# Railway users should set this to true; Railway supplies the client address in X-Real-IP.
TRUST_PROXY_HEADERS=false
# Comma-separated proxy networks allowed to supply X-Forwarded-For/X-Real-IP.
TRUSTED_PROXY_CIDRS=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
